    font-size: 0.95rem;
    line-height: 1.6;
    color: rgb(var(--color-ink-soft));
    margin: 0 0 1.6rem;
  }

  /* ── Restaurant-Karten ────────────────────────────────────── */
  .nw-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    margin-bottom: 1.6rem;
  }
  .nw-card {
    display: flex;
    flex-direction: column;
    text-align: left;
    font: inherit;
    text-decoration: none;
    border: none;
    border-radius: var(--corner-radius);
    overflow: hidden;
    background: rgb(var(--color-paper));
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .nw-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(var(--color-ink), 0.16);
  }
  .nw-card__img { position: relative; width: 100%; aspect-ratio: 4/3; overflow: hidden; background: rgba(var(--color-ink), 0.06); flex-shrink: 0; }
  .nw-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s var(--ease); }
  .nw-card:hover .nw-card__img img { transform: scale(1.05); }
  .nw-card__body { padding: 0.95rem 1.1rem 1.1rem; display: flex; flex-direction: column; gap: 0.25rem; flex: 1; }
  .nw-card__name { font-family: var(--font-header-family); font-size: 1.05rem; color: rgb(var(--color-ink)); }
  .nw-card__desc { font-family: var(--font-body-family); font-size: 0.82rem; color: rgb(var(--color-ink-soft)); }
