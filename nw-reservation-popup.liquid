  #nw-iframe-close {
    background: rgba(251, 250, 247, 0.12);
    border: 1px solid rgba(251, 250, 247, 0.25);
    border-radius: 50%;
    width: 2.5rem; height: 2.5rem;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: rgb(var(--color-cream));
    transition: background 0.2s var(--ease);
    flex-shrink: 0; padding: 0;
  }
  #nw-iframe-close:hover { background: rgba(251, 250, 247, 0.22); }
  #nw-iframe-close svg { width: 1.2rem; height: 1.2rem; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; fill: none; }
  #nw-iframe-loading {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
