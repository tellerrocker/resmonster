          <span class="nw-event-hint">Genussmärkte, Weinabende &amp; besondere Anlässe</span>
        </div>
        <span class="nw-ev-arrow">›</span>
      </a>
    </div>
  </div>
</div>

<!-- ── Buchungs-iFrame-Modal (OpenTable + Zenchef) ─────────── -->
<!-- Auch hier bewusst kein Klick-außerhalb-schließt: nur der X-Button schließt. -->
<div id="nw-iframe-overlay">
  <div id="nw-iframe-box">
    <div id="nw-iframe-header">
      <span id="nw-iframe-title">Reservierung</span>
      <button id="nw-iframe-close" onclick="closeNwFrame()" aria-label="Schließen">
        <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div id="nw-iframe-wrap">
      <div id="nw-iframe-loading">Wird geladen …</div>
      <iframe id="nw-iframe-el" src="" title="Tischreservierung" allowfullscreen></iframe>
    </div>
  </div>
</div>

<script>
  function openNwPopup() {
    document.getElementById('nw-overlay').classList.add('nw-open');
    document.body.style.overflow = 'hidden';
  }

  function closeNwPopup() {
    document.getElementById('nw-overlay').classList.remove('nw-open');
    document.body.style.overflow = '';
  }

  function openNwFrame(url, title) {
    var overlay = document.getElementById('nw-iframe-overlay');
    var iframe  = document.getElementById('nw-iframe-el');
    var loading = document.getElementById('nw-iframe-loading');
    var heading = document.getElementById('nw-iframe-title');
    heading.textContent = title;
    loading.classList.remove('nw-hidden');
    iframe.src = '';
    iframe.onload = function () { loading.classList.add('nw-hidden'); };
    iframe.src = url;
    overlay.classList.add('nw-open');
    document.body.style.overflow = 'hidden';
  }

  function closeNwFrame() {
    document.getElementById('nw-iframe-overlay').classList.remove('nw-open');
    document.getElementById('nw-iframe-el').src = '';
    document.body.style.overflow = '';
  }

  document.getElementById('nw-res-btn').addEventListener('click', openNwPopup);

  /* Globaler Trigger: JEDER Link auf der Seite mit href="#opentable" öffnet
     das Popup. Funktioniert auch für später per AJAX/JS nachgeladene Links,
     da über document delegiert wird. */
  document.addEventListener('click', function (e) {
    var trigger = e.target.closest('a[href="#opentable"]');
    if (!trigger) return;
    e.preventDefault();
    openNwPopup();
  });
</script>
<!-- ================================================ END NAMINE WITT PopUp ================================================ -->
