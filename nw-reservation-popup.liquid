  .nw-card__arrow svg { width: 1.2rem; height: 1.2rem; stroke: currentColor; stroke-width: 1.8; fill: none; stroke-linecap: round; stroke-linejoin: round; }

  /* ── Fondue-Stube: volle Breite, ca. 1/3 der Höhe der Karten oben ── */
  .nw-card--wide {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: stretch;
    height: 6.5rem;
  }
  .nw-card--wide .nw-card__img {
    width: 34%;
    height: 100%;
    aspect-ratio: auto;
  }
  .nw-card--wide .nw-card__body {
    flex-direction: row;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 1.1rem;
    min-width: 0;
  }
  .nw-card__text { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; min-width: 0; }
  .nw-card__tag {
    font-family: var(--font-body-family);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-sage-deep));
    line-height: 1.2;
