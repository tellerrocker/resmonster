  }
  #nw-iframe-loading.nw-hidden { opacity: 0; pointer-events: none; }
  #nw-iframe-wrap { flex: 1; position: relative; overflow: hidden; }
  #nw-iframe-wrap iframe { width: 100%; height: 100%; border: none; display: block; }
