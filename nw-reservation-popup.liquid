  }
  #nw-res-btn:hover {
    background: rgb(var(--color-sage-deep));
    transform: translateY(-2px);
  }
  #nw-res-btn svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.8;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
