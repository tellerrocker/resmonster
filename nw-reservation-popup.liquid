      width: 70%;
      max-width: 46rem;
      height: auto;
      max-height: 100%;
      border-radius: var(--corner-radius);
      box-shadow: 0 30px 80px rgba(0, 20, 25, 0.35);
    }
  }

  /* ── Header ───────────────────────────────────────────────── */
  #nw-popup-header {
    background: rgb(var(--color-ink));
    padding: 1.6rem var(--edge);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  #nw-popup-header .nw-brand { display: flex; flex-direction: column; gap: 0.2rem; }
  #nw-popup-header .nw-brand-name {
    color: rgb(var(--color-cream));
    font-family: var(--font-header-family);
    font-size: 1.3rem;
    line-height: 1.2;
  }
  #nw-popup-header .nw-brand-sub {
