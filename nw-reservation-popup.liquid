  /* ── Body ─────────────────────────────────────────────────── */
  #nw-popup-body { padding: clamp(1.8rem, 4vw, 2.4rem) var(--edge) 2rem; }
  #nw-popup-body h3 {
    font-family: var(--font-header-family);
    font-size: clamp(1.4rem, 2.4vw, 1.7rem);
