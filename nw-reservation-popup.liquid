  }
  #nw-overlay.nw-open {
    display: flex;
    animation: nwFadeIn 0.3s var(--ease);
  }
  @keyframes nwFadeIn { from { opacity: 0; } to { opacity: 1; } }

  /* ── PopUp-Karte: 70% Desktop mit Rand oben/unten, 100% mobil ─ */
  #nw-popup {
