    .nw-card--wide .nw-card__desc { font-size: 0.76rem; line-height: 1.3; }
  }

  /* ── Trennlinie ───────────────────────────────────────────── */
  .nw-divider { border: none; height: 1px; background: rgba(var(--color-ink), 0.14); margin: 1.6rem 0; }

  /* ── SHGF-Feature-Karte ───────────────────────────────────── */
  .nw-feature {
